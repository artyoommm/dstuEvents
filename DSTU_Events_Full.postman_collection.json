{
	"info": {
		"_postman_id": "f83e1a4b-6b7f-4a08-b3c5-0e1f2d3c4b5a",
		"name": "DSTU Events Lab 4 (Full Demo)",
		"description": "Коллекция для полной проверки всех сценариев ЛР4",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Создать и Опубликовать (Admin)",
			"item": [
				{
					"name": "1. Create Event",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"event_id\", jsonData.id);",
									"pm.test(\"Event Created\", function () { pm.response.to.have.status(201); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "X-Roles", "value": "admin"},
							{"key": "Idempotency-Key", "value": "{{$guid}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"День открытых дверей ИТ-факультета\",\n  \"description\": \"Знакомство с кафедрами\",\n  \"type\": \"OPEN_DAY\",\n  \"startsAt\": \"2026-12-01T10:00:00Z\",\n  \"endsAt\": \"2026-12-01T14:00:00Z\",\n  \"venueId\": 12,\n  \"seatLimit\": 5\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/admin/events",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "admin", "events"]
						}
					},
					"response": []
				},
				{
					"name": "2. Publish Event",
					"request": {
						"method": "POST",
						"header": [{"key": "X-Roles", "value": "admin"}],
						"url": {
							"raw": "{{base_url}}/api/v1/admin/events/{{event_id}}/publish",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "admin", "events", "{{event_id}}", "publish"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "02. Регистрация (Сага)",
			"item": [
				{
					"name": "3. Register (Happy Path)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"registration_id\", jsonData.id);",
									"pm.collectionVariables.set(\"qr_token\", jsonData.qrToken);",
									"pm.test(\"Registration Success\", function () { pm.response.to.have.status(201); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "X-Student-Id", "value": "u-active"},
							{"key": "Idempotency-Key", "value": "{{$guid}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"eventId\": \"{{event_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/registrations",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "registrations"]
						}
					},
					"response": []
				},
				{
					"name": "4. Register (Banned Student)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "X-Student-Id", "value": "u-banned"},
							{"key": "Idempotency-Key", "value": "{{$guid}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"eventId\": \"{{event_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/registrations",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "registrations"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "03. Посещаемость и Баллы",
			"item": [
				{
					"name": "5. Scan QR (Attendance)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Idempotency-Key", "value": "{{$guid}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"qrToken\": \"{{qr_token}}\",\n  \"eventId\": \"{{event_id}}\",\n  \"scannedBy\": \"volunteer-1\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/attendance/scan",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "attendance", "scan"]
						}
					},
					"response": []
				},
				{
					"name": "6. Mark No-Show",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Idempotency-Key", "value": "{{$guid}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"registrationId\": \"{{registration_id}}\",\n  \"eventId\": \"{{event_id}}\",\n  \"markedBy\": \"volunteer-1\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/attendance/no-show",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "attendance", "no-show"]
						}
					},
					"response": []
				},
				{
					"name": "7. Check Points",
					"request": {
						"method": "GET",
						"header": [
							{"key": "X-Student-Id", "value": "u-active"}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/profile/me",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "profile", "me"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "04. Проверка Асинхронности",
			"item": [
				{
					"name": "8. Check Notifications (Emails)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/internal/v1/notifications",
							"host": ["{{base_url}}"],
							"path": ["internal", "v1", "notifications"]
						}
					},
					"response": []
				},
				{
					"name": "9. Cancel Event (Async Test)",
					"request": {
						"method": "DELETE",
						"header": [
							{"key": "X-Roles", "value": "admin"}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/admin/events/{{event_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "admin", "events", "{{event_id}}"]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000"
		},
		{
			"key": "event_id",
			"value": ""
		},
		{
			"key": "registration_id",
			"value": ""
		},
		{
			"key": "qr_token",
			"value": ""
		}
	]
}